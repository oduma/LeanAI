<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LeanAI.Maui.ViewModels"
    xmlns:svc="clr-namespace:LeanAI.Application.WeightManagement.Services;assembly=LeanAI.Application"
    x:Class="LeanAI.Maui.Views.Import.ImportWizardPage"
    x:DataType="vm:ImportWizardViewModel"
    Title="Import from Google Sheets"
    BackgroundColor="{StaticResource ColorBase}">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="0">

            <!-- ── STEP 1: Sign In ─────────────────────────────────────── -->
            <VerticalStackLayout
                IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter='1'}"
                Spacing="24">

                <Label
                    Text="CONNECT YOUR ACCOUNT"
                    TextColor="{StaticResource ColorNickel}"
                    FontSize="11"
                    CharacterSpacing="2" />

                <Label
                    Text="Sign in with Google to access your spreadsheets. Only read-only access is requested."
                    TextColor="{StaticResource ColorText}"
                    FontSize="15"
                    LineBreakMode="WordWrap" />

                <!-- Sign-In button -->
                <Border
                    BackgroundColor="{StaticResource ColorCopper}"
                    StrokeThickness="0"
                    Padding="0"
                    Margin="0,16,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label
                        Text="Sign in with Google"
                        TextColor="{StaticResource ColorBase}"
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        Padding="0,14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SignInWithGoogleCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>

                <!-- Busy indicator -->
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource ColorCopper}"
                    HorizontalOptions="Center" />

                <!-- Error -->
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource ColorCopper}"
                    FontSize="13"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>

            <!-- ── STEP 2: Select Spreadsheet ─────────────────────────── -->
            <VerticalStackLayout
                IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter='2'}"
                Spacing="16">

                <Label
                    Text="SELECT SPREADSHEET"
                    TextColor="{StaticResource ColorNickel}"
                    FontSize="11"
                    CharacterSpacing="2" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource ColorCopper}"
                    HorizontalOptions="Center" />

                <CollectionView
                    ItemsSource="{Binding Spreadsheets}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="svc:SpreadsheetSummary">
                            <Border
                                BackgroundColor="#2A2A2A"
                                StrokeThickness="0"
                                Padding="0"
                                Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid
                                    Padding="16,14"
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Name}"
                                        TextColor="{StaticResource ColorText}"
                                        FontSize="15"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="›"
                                        TextColor="{StaticResource ColorNickel}"
                                        FontSize="22"
                                        VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ImportWizardViewModel}}, Path=SelectSpreadsheetCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource ColorCopper}"
                    FontSize="13"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>

            <!-- ── STEP 3: Map Columns ────────────────────────────────── -->
            <VerticalStackLayout
                IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter='3'}"
                Spacing="20">

                <Label
                    Text="MAP COLUMNS"
                    TextColor="{StaticResource ColorNickel}"
                    FontSize="11"
                    CharacterSpacing="2" />

                <!-- Date column picker -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Date column" TextColor="{StaticResource ColorNickel}" FontSize="13" />
                    <Border BackgroundColor="#2A2A2A" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Picker
                            ItemsSource="{Binding Columns}"
                            SelectedItem="{Binding SelectedDateColumn}"
                            TextColor="{StaticResource ColorText}"
                            BackgroundColor="Transparent"
                            TitleColor="{StaticResource ColorNickel}"
                            Title="Select date column"
                            Margin="12,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- Weight column picker -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Weight column" TextColor="{StaticResource ColorNickel}" FontSize="13" />
                    <Border BackgroundColor="#2A2A2A" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Picker
                            ItemsSource="{Binding Columns}"
                            SelectedItem="{Binding SelectedWeightColumn}"
                            TextColor="{StaticResource ColorText}"
                            BackgroundColor="Transparent"
                            TitleColor="{StaticResource ColorNickel}"
                            Title="Select weight column"
                            Margin="12,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- Notes column picker (optional) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Notes column (optional)" TextColor="{StaticResource ColorNickel}" FontSize="13" />
                    <Border BackgroundColor="#2A2A2A" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Picker
                            ItemsSource="{Binding Columns}"
                            SelectedItem="{Binding SelectedNotesColumn}"
                            TextColor="{StaticResource ColorText}"
                            BackgroundColor="Transparent"
                            TitleColor="{StaticResource ColorNickel}"
                            Title="None"
                            Margin="12,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- Units toggle -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sheet units" TextColor="{StaticResource ColorNickel}" FontSize="13" />
                    <HorizontalStackLayout Spacing="16">
                        <Label
                            Text="Metric (kg)"
                            TextColor="{Binding IsImperial, Converter={StaticResource BoolToColorConverter}, ConverterParameter='ColorNickel|ColorCopper'}"
                            FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        <Switch IsToggled="{Binding IsImperial}" OnColor="{StaticResource ColorCopper}" />
                        <Label
                            Text="Imperial (lbs)"
                            TextColor="{Binding IsImperial, Converter={StaticResource BoolToColorConverter}, ConverterParameter='ColorCopper|ColorNickel'}"
                            FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Error -->
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource ColorCopper}"
                    FontSize="13"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    LineBreakMode="WordWrap" />

                <HorizontalStackLayout Spacing="12">
                    <Border
                        BackgroundColor="#2A2A2A"
                        StrokeThickness="0"
                        HorizontalOptions="Start"
                        Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label
                            Text="← Back"
                            TextColor="{StaticResource ColorNickel}"
                            FontSize="15"
                            Padding="20,12">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                    <Border
                        BackgroundColor="{StaticResource ColorCopper}"
                        StrokeThickness="0"
                        HorizontalOptions="Fill"
                        Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label
                            Text="Next →"
                            TextColor="{StaticResource ColorBase}"
                            FontSize="15"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Padding="0,12">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ProceedToConfirmCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </HorizontalStackLayout>

            </VerticalStackLayout>

            <!-- ── STEP 4: Confirm ────────────────────────────────────── -->
            <VerticalStackLayout
                IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter='4'}"
                Spacing="20">

                <Label
                    Text="⚠  BEFORE YOU CONTINUE"
                    TextColor="{StaticResource ColorCopper}"
                    FontSize="18"
                    FontAttributes="Bold" />

                <Label
                    Text="This import will permanently change your data:"
                    TextColor="{StaticResource ColorText}"
                    FontSize="15" />

                <Border
                    BackgroundColor="#2A2A2A"
                    StrokeThickness="0"
                    Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Label
                        Text="{Binding ConfirmationDetails}"
                        TextColor="{StaticResource ColorNickel}"
                        FontSize="14"
                        LineBreakMode="WordWrap" />
                </Border>

                <HorizontalStackLayout Spacing="12">
                    <Border
                        BackgroundColor="#2A2A2A"
                        StrokeThickness="0"
                        HorizontalOptions="Start"
                        Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label
                            Text="Cancel"
                            TextColor="{StaticResource ColorNickel}"
                            FontSize="15"
                            Padding="20,12">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                    <Border
                        BackgroundColor="{StaticResource ColorCopper}"
                        StrokeThickness="0"
                        HorizontalOptions="Fill"
                        Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label
                            Text="Confirm Import"
                            TextColor="{StaticResource ColorBase}"
                            FontSize="15"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Padding="0,12">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ConfirmImportCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </HorizontalStackLayout>

            </VerticalStackLayout>

            <!-- ── STEP 5: Progress & Summary ─────────────────────────── -->
            <VerticalStackLayout
                IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter='5'}"
                Spacing="20">

                <!-- Busy / importing -->
                <VerticalStackLayout
                    IsVisible="{Binding IsBusy}"
                    Spacing="16"
                    HorizontalOptions="Center">
                    <ActivityIndicator
                        IsRunning="True"
                        Color="{StaticResource ColorCopper}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="{Binding BusyMessage}"
                        TextColor="{StaticResource ColorNickel}"
                        FontSize="15"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Summary (visible when not busy) -->
                <VerticalStackLayout
                    IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Spacing="16">

                    <Label
                        Text="IMPORT COMPLETE"
                        TextColor="{StaticResource ColorCopper}"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Border BackgroundColor="#2A2A2A" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">

                            <!-- Dates / ideal line -->
                            <Label
                                Text="DATES"
                                TextColor="{StaticResource ColorNickel}"
                                FontSize="11"
                                CharacterSpacing="2" />
                            <Label
                                TextColor="{StaticResource ColorText}"
                                FontSize="15">
                                <Label.Text>
                                    <MultiBinding StringFormat="📅  {0}  dates found in spreadsheet">
                                        <Binding Path="ImportSummary.TotalDatesFound" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label
                                TextColor="{StaticResource ColorCopper}"
                                FontSize="15">
                                <Label.Text>
                                    <MultiBinding StringFormat="✓  {0}  days on ideal weight line">
                                        <Binding Path="ImportSummary.IdealDatesImported" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <!-- Separator -->
                            <BoxView HeightRequest="1" Color="#3A3A3A" Margin="0,4" />

                            <!-- Actual weights -->
                            <Label
                                Text="ACTUAL WEIGHTS"
                                TextColor="{StaticResource ColorNickel}"
                                FontSize="11"
                                CharacterSpacing="2" />
                            <Label
                                TextColor="{StaticResource ColorText}"
                                FontSize="15">
                                <Label.Text>
                                    <MultiBinding StringFormat="📅  {0}  dates with a recorded weight">
                                        <Binding Path="ImportSummary.DatesWithWeightsFound" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label
                                TextColor="{StaticResource ColorCopper}"
                                FontSize="15">
                                <Label.Text>
                                    <MultiBinding StringFormat="✓  {0}  weight entries saved">
                                        <Binding Path="ImportSummary.WeightRowsImported" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <!-- Failed -->
                            <Label
                                TextColor="{StaticResource ColorNickel}"
                                FontSize="14"
                                IsVisible="{Binding ImportSummary.Failed, Converter={StaticResource IntGreaterThanZeroConverter}}">
                                <Label.Text>
                                    <MultiBinding StringFormat="✗  {0}  rows could not be parsed">
                                        <Binding Path="ImportSummary.Failed" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Text="Your ideal path has been recalculated. View your history in the Trends tab."
                        TextColor="{StaticResource ColorText}"
                        FontSize="14"
                        LineBreakMode="WordWrap" />

                    <!-- Done button -->
                    <Border
                        BackgroundColor="{StaticResource ColorCopper}"
                        StrokeThickness="0"
                        Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Label
                            x:Name="DoneLabel"
                            Text="Done"
                            TextColor="{StaticResource ColorBase}"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Padding="0,14" />
                    </Border>

                    <!-- Error (if import failed) -->
                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="{StaticResource ColorCopper}"
                        FontSize="13"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
