<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LeanAI.Maui.ViewModels"
    xmlns:dto="clr-namespace:LeanAI.Application.FoodTracking.DTOs;assembly=LeanAI.Application"
    x:Class="LeanAI.Maui.Views.CaloriesDetail.CaloriesDetailPage"
    x:DataType="vm:CaloriesDetailViewModel"
    BackgroundColor="{StaticResource ColorBase}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header row: title + Save Routine + Close -->
        <Grid
            Grid.Row="0"
            Padding="24,32,24,12"
            ColumnDefinitions="*,Auto,Auto">
            <Label
                Grid.Column="0"
                Text="Calories Detail"
                TextColor="{StaticResource ColorText}"
                FontSize="24"
                FontAttributes="Bold"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Text="Save Routine"
                IsVisible="{Binding AreCheckboxesEnabled}"
                IsEnabled="{Binding HasAnyChecked}"
                BackgroundColor="{StaticResource ColorCopper}"
                TextColor="White"
                FontSize="13"
                CornerRadius="8"
                Padding="10,6"
                Margin="0,0,8,0"
                Command="{Binding SaveRoutineCommand}"
                VerticalOptions="Center" />
            <Button
                Grid.Column="2"
                Text="✕"
                BackgroundColor="Transparent"
                TextColor="{StaticResource ColorNickel}"
                FontSize="20"
                Padding="8,0"
                Command="{Binding CloseCommand}"
                VerticalOptions="Center" />
        </Grid>

        <!-- Current Routine switch -->
        <Border
            Grid.Row="1"
            BackgroundColor="#2A2A2A"
            StrokeThickness="0"
            Padding="0"
            Margin="24,0,24,8">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label
                        Text="Current Routine"
                        TextColor="{StaticResource ColorText}"
                        FontSize="15"
                        FontAttributes="Bold" />
                    <Label
                        Text="Apply your recurring items to this day"
                        TextColor="{StaticResource ColorNickel}"
                        FontSize="12" />
                </VerticalStackLayout>
                <Switch
                    Grid.Column="1"
                    IsToggled="{Binding IsRoutineActive}"
                    OnColor="{StaticResource ColorCopper}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="24,0" Spacing="16">

                <!-- BMR section (formula-calculated, read-only, no routine checkbox) -->
                <Border
                    BackgroundColor="#2A2A2A"
                    StrokeThickness="0"
                    Padding="0"
                    IsVisible="{Binding HasBmr}"
                    Margin="0,8,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid Padding="14,14" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label
                                Text="BASAL METABOLIC RATE"
                                TextColor="{StaticResource ColorNickel}"
                                FontSize="11"
                                CharacterSpacing="1" />
                            <Label
                                Text="{Binding BmrText}"
                                TextColor="{StaticResource ColorCopper}"
                                FontSize="26"
                                FontAttributes="Bold" />
                            <Label
                                Text="Mifflin-St Jeor · Read only"
                                TextColor="{StaticResource ColorNickel}"
                                FontSize="11" />
                        </VerticalStackLayout>
                        <!-- BMR checkbox always disabled -->
                        <CheckBox
                            Grid.Column="1"
                            IsChecked="False"
                            IsEnabled="False"
                            Color="{StaticResource ColorNickel}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Food section header -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                    <Label
                        Grid.Column="0"
                        Text="Food"
                        TextColor="{StaticResource ColorText}"
                        FontSize="18"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Text="Routine"
                        TextColor="{StaticResource ColorNickel}"
                        FontSize="11"
                        CharacterSpacing="1"
                        VerticalOptions="Center"
                        Margin="0,0,4,0" />
                    <Button
                        Grid.Column="2"
                        Text="Edit"
                        BackgroundColor="#2A2A2A"
                        TextColor="{StaticResource ColorCopper}"
                        CornerRadius="8"
                        FontSize="14"
                        Padding="14,6"
                        Command="{Binding EditFoodCommand}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- Food items list -->
                <CollectionView
                    ItemsSource="{Binding FoodItemVMs}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CaloriesDetailFoodItemViewModel">
                            <Border
                                BackgroundColor="#2A2A2A"
                                StrokeThickness="0"
                                Padding="0"
                                Margin="0,0,0,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid Padding="14,10" ColumnDefinitions="*,Auto,Auto">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Dto.FoodItem}"
                                            TextColor="{StaticResource ColorText}"
                                            FontSize="15" />
                                        <Label
                                            Text="{Binding Dto.Quantity}"
                                            TextColor="{StaticResource ColorNickel}"
                                            FontSize="12"
                                            IsVisible="{Binding Dto.Quantity, Converter={StaticResource StringNotEmptyConverter}}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Dto.Calories, StringFormat='{0:N0} kcal'}"
                                        TextColor="{StaticResource ColorNickel}"
                                        FontSize="13"
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0" />
                                    <CheckBox
                                        Grid.Column="2"
                                        IsChecked="{Binding IsRoutineChecked}"
                                        IsEnabled="{Binding IsRoutineEnabled}"
                                        Color="{StaticResource ColorCopper}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Food total -->
                <Border
                    BackgroundColor="#2A2A2A"
                    StrokeThickness="0"
                    Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="Food Total"
                            TextColor="{StaticResource ColorText}"
                            FontSize="15"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding FoodTotalText}"
                            TextColor="{StaticResource ColorCopper}"
                            FontSize="15"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Activities section header -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                    <Label
                        Grid.Column="0"
                        Text="Activities"
                        TextColor="{StaticResource ColorText}"
                        FontSize="18"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Text="Routine"
                        TextColor="{StaticResource ColorNickel}"
                        FontSize="11"
                        CharacterSpacing="1"
                        VerticalOptions="Center"
                        Margin="0,0,4,0" />
                    <Button
                        Grid.Column="2"
                        Text="Edit"
                        BackgroundColor="#2A2A2A"
                        TextColor="{StaticResource ColorCopper}"
                        CornerRadius="8"
                        FontSize="14"
                        Padding="14,6"
                        Command="{Binding EditActivitiesCommand}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- Activity items list -->
                <CollectionView
                    ItemsSource="{Binding ActivityItemVMs}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CaloriesDetailActivityItemViewModel">
                            <Border
                                BackgroundColor="#2A2A2A"
                                StrokeThickness="0"
                                Padding="0"
                                Margin="0,0,0,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid Padding="14,10" ColumnDefinitions="*,Auto,Auto">
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Dto.Description}"
                                        TextColor="{StaticResource ColorText}"
                                        FontSize="15"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Dto.Calories, StringFormat='-{0:N0} kcal'}"
                                        TextColor="{StaticResource ColorNickel}"
                                        FontSize="13"
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0" />
                                    <CheckBox
                                        Grid.Column="2"
                                        IsChecked="{Binding IsRoutineChecked}"
                                        IsEnabled="{Binding IsRoutineEnabled}"
                                        Color="{StaticResource ColorCopper}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Activity total -->
                <Border
                    BackgroundColor="#2A2A2A"
                    StrokeThickness="0"
                    Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="Activity Burned"
                            TextColor="{StaticResource ColorText}"
                            FontSize="15"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding ActivityTotalText}"
                            TextColor="{StaticResource ColorCopper}"
                            FontSize="15"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Net total at bottom -->
        <Border
            Grid.Row="3"
            BackgroundColor="#1A1A1A"
            StrokeThickness="0"
            Margin="24,0,24,32"
            Padding="20,16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Grid.Column="0"
                    Text="Net Calories"
                    TextColor="{StaticResource ColorText}"
                    FontSize="18"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="{Binding NetCaloriesText}"
                    TextColor="{StaticResource ColorCopper}"
                    FontSize="20"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
