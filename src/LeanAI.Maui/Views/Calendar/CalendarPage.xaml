<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LeanAI.Maui.ViewModels"
    x:Class="LeanAI.Maui.Views.Calendar.CalendarPage"
    x:DataType="vm:CalendarViewModel"
    BackgroundColor="{StaticResource ColorBase}">

    <!--
        Row 0 : page title + loading spinner   (auto)
        Row 1 : month navigation header        (auto)
        Row 2 : day-of-week column headers     (auto)
        Row 3 : calendar grid                  (* — fills remaining space)
        Row 4 : empty-state message            (* — shown when HasData=false)
    -->
    <Grid Padding="16,24,16,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: title + spinner -->
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label
                Text="Calendar"
                TextColor="{StaticResource ColorText}"
                FontSize="22"
                FontAttributes="Bold" />
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource ColorCopper}"
                HorizontalOptions="Start" />
        </VerticalStackLayout>

        <!-- Row 1: month navigation -->
        <Grid Grid.Row="1" ColumnDefinitions="72,*,72">

            <!-- Previous month — large tap zone -->
            <Grid
                Grid.Column="0"
                Padding="20,16"
                BackgroundColor="Transparent">
                <Label
                    Text="&#x276E;"
                    TextColor="{StaticResource ColorCopper}"
                    FontSize="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PreviousMonthCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

            <Label
                Grid.Column="1"
                Text="{Binding MonthLabel}"
                TextColor="{StaticResource ColorText}"
                FontSize="16"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!-- Next month — large tap zone -->
            <Grid
                Grid.Column="2"
                Padding="20,16"
                BackgroundColor="Transparent">
                <Label
                    Text="&#x276F;"
                    TextColor="{StaticResource ColorCopper}"
                    FontSize="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NextMonthCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

        </Grid>

        <!-- Row 2: day-of-week column headers -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding ColumnHeaders}"
            IsVisible="{Binding HasData}"
            HeightRequest="28">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="7" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Label
                        Text="{Binding .}"
                        TextColor="{StaticResource ColorNickel}"
                        FontSize="11"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Row 3: calendar cells -->
        <CollectionView
            x:Name="CalendarGrid"
            Grid.Row="3"
            ItemsSource="{Binding Days}"
            IsVisible="{Binding HasData}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="7" VerticalItemSpacing="2" HorizontalItemSpacing="2" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarDayViewModel">
                    <!-- Tappable cell -->
                    <Grid
                        Padding="2"
                        HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type vm:CalendarViewModel}}, Path=CellHeight}"
                        Opacity="{Binding Opacity}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CalendarViewModel}}, Path=DayTappedCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <!-- Halo circle -->
                        <Ellipse
                            IsVisible="{Binding HasHalo}"
                            Stroke="{Binding HaloStrokeColor}"
                            StrokeThickness="2.5"
                            Fill="Transparent"
                            HeightRequest="50"
                            WidthRequest="50"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <!-- Day number -->
                        <Label
                            Text="{Binding DayNumber}"
                            TextColor="{Binding DayNumberColor}"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Row 3: empty state -->
        <Label
            Grid.Row="3"
            IsVisible="{Binding HasData, Converter={StaticResource InverseBoolConverter}}"
            Text="No goal set — complete setup to see your calendar."
            TextColor="{StaticResource ColorNickel}"
            FontSize="14"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>

</ContentPage>
