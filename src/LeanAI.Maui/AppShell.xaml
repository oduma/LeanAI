<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LeanAI.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:log="clr-namespace:LeanAI.Maui.Views.Log"
    xmlns:trends="clr-namespace:LeanAI.Maui.Views.Trends"
    xmlns:calendar="clr-namespace:LeanAI.Maui.Views.Calendar"
    xmlns:settings="clr-namespace:LeanAI.Maui.Views.Settings"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource ColorBase}">

    <TabBar>
        <ShellContent
            Title="Log"
            Icon="log_tab.svg"
            ContentTemplate="{DataTemplate log:LogPage}"
            Route="Log" />
        <ShellContent
            Title="Trends"
            Icon="trends_tab.svg"
            ContentTemplate="{DataTemplate trends:TrendsPage}"
            Route="Trends" />
        <ShellContent
            Title="Calendar"
            Icon="calendar_tab.svg"
            ContentTemplate="{DataTemplate calendar:CalendarPage}"
            Route="Calendar" />
        <ShellContent
            Title="Settings"
            Icon="settings_tab.svg"
            ContentTemplate="{DataTemplate settings:SettingsPage}"
            Route="Settings" />
    </TabBar>

</Shell>
