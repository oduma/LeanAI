<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:LeanAI.Maui.Converters"
             x:Class="LeanAI.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToColorConverter   x:Key="BoolToColorConverter" />
            <conv:BoolToImageConverter   x:Key="BoolToImageConverter" />
            <conv:BoolToStringConverter  x:Key="BoolToStringConverter" />
            <conv:InverseBoolConverter   x:Key="InverseBoolConverter" />
            <conv:GenderToColorConverter x:Key="GenderToColorConverter" />
            <conv:PeriodToColorConverter x:Key="PeriodToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
